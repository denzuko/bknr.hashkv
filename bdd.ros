#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -Q -- $0 "$@"
|#
(progn
  (ros:ensure-asdf))

(let ((root (merge-pathnames "" *load-pathname*)))
  (push root asdf:*central-registry*))

(asdf:load-system :bknr.hashkv/bdd :verbose nil)

(defun main (&rest argv)
  "Runs every Scenario in bknr.hashkv.feature and exits 0 on success,
1 on failure."
  (declare (ignorable argv))
  (uiop:quit (if (bknr.hashkv/bdd:run-bdd) 0 1)))
